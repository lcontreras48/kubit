  "cards": [
    {
      "dot": "cyan",
      "title": "Información base",
      "items": [
        "Kubernetes API + ClusterRole list-only producen inventario y versiones",
        "Las fuentes upstream aportan matrices; stale o unknown nunca se vuelven supported",
        "El cache conserva evidencia y checksum cuando una fuente temporalmente falla"
      ]
    },
    {
      "dot": "rose",
      "title": "Integraciones opcionales",
      "items": [
        "Argo CD agrega propiedad, sync y health de Applications",
        "Trivy Operator debe crear los report CRs; Kubit solamente los lee",
        "PostgreSQL habilita autenticación, propuestas, auditoría e historial"
      ]
    },
    {
      "dot": "emerald",
      "title": "Observabilidad",
      "items": [
        "Prometheus extrae /metrics: Kubit nunca consulta Prometheus",
        "Grafana consulta Prometheus y descubre el dashboard ConfigMap",
        "ServiceMonitor, PrometheusRule y dashboard son recursos opt-in"
      ]
    }
  ]
