{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Kubit Helm values",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "clusterName": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] },
        "scanIntervalSeconds": { "type": "integer", "minimum": 1 },
        "evidenceRefreshIntervalSeconds": { "type": "integer", "minimum": 1 },
        "evidenceStaleAfterSeconds": { "type": "integer", "minimum": 1 },
        "catalogEvidenceMaxAgeDays": { "type": "integer", "minimum": 1 },
        "securityReportStaleAfterSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "scanStaleAfterSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "database": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "instances": { "type": "integer", "minimum": 1 },
        "existingAppSecret": { "type": "string" },
        "database": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "existingAppSecret": { "minLength": 1 } } }
        }
      ]
    }
  }
}

